<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Com.H.Text.Template2</AssemblyName>
    <RootNamespace>Com.H.Text.Template2</RootNamespace>
    <!-- 10.x aligns with the rest of the Com.H family (Com.H 10.2.0, Com.H.Data.Common 10.1.x,
         Com.H.EF.Relational 10.0.x), where the major version tracks the .NET generation rather
         than this package's own lifecycle. -->
    <Version>10.0.0</Version>
    <Authors>Hussein Al Bayati</Authors>
    <Description>Connects the Com.H templating engine to any ADO.NET database via Com.H.Data.Common. Queries embedded in templates are executed with real SQL parameters rather than textual substitution.</Description>
    <Copyright>Hussein Al Bayati</Copyright>
    <PackageProjectUrl>https://github.com/H7O/Com.H.Text.Template2</PackageProjectUrl>
    <PackageIcon>128x128.jpg</PackageIcon>
    <PackageReadmeFile>nuget.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/H7O/Com.H.Text.Template2</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>templating, ADO.Net, dynamic query results, sql parameters</PackageTags>
    <PackageReleaseNotes>Initial release</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Deterministic builds for reproducibility -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Source Link - enables stepping into source code when debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Embed debug symbols in the assembly (avoids separate .snupkg) -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- The parameter-model mapping is an implementation detail, but it is the part most worth
       unit-testing directly, so the test assembly gets access rather than the API being widened. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Com.H.Text.Template2.Tests" />
  </ItemGroup>

  <!--
    The compiler writes an XML doc entry for every member carrying a /// comment, whatever its
    accessibility — so the shipped file otherwise describes internal methods and private fields
    (21% of it, measured). Those comments are for maintainers reading the source, not for
    consumers, so they are stripped from the built XML while staying in the code.

    DocFilterInternalType lists the types to strip, matched as a prefix so nested types and
    members go with them. TemplateEngineIsInternal in the test suite fails if a new internal type
    is added without a corresponding entry here, so the list cannot silently rot.
  -->
  <ItemGroup>
    <DocFilterInternalType Include="Com.H.Text.Template2.TemplateEngine" />
    <DocFilterInternalType Include="Com.H.Text.Template2.TemplateExtensions.StrictNoDataProvider" />
  </ItemGroup>

  <UsingTask TaskName="FilterXmlDoc" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <DocFile ParameterType="System.String" Required="true" />
      <Prefixes ParameterType="System.String[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!System.IO.File.Exists(DocFile)) return true;
        var doc = XDocument.Load(DocFile);
        var members = doc.Root.Element("members");
        if (members == null) return true;

        var drop = members.Elements("member")
            .Where(m => Prefixes.Any(p =>
            {
                var name = (string)m.Attribute("name");
                if (string.IsNullOrEmpty(name) || name.Length < 3) return false;
                var target = name.Substring(2);            // strip the "T:" / "M:" / "F:" tag
                return target == p || target.StartsWith(p + ".") || target.StartsWith(p + "(");
            }))
            .ToList();

        foreach (var m in drop) m.Remove();
        if (drop.Count > 0) doc.Save(DocFile);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Runs right after the compiler writes the file into obj/. Build then copies it to bin/,
       which is what dotnet pack ships and what a referencing project sees. Running after Build
       instead filtered obj/ only after the unfiltered copy had already gone out, so a clean pack
       shipped the internal docs and the bin/ copy only caught up on the NEXT build. -->
  <Target Name="StripInternalXmlDocs" AfterTargets="CoreCompile"
          Condition="'$(DocumentationFile)' != ''">
    <FilterXmlDoc DocFile="$(DocumentationFile)"
                  Prefixes="@(DocFilterInternalType)" />
  </Target>

  <!-- Source Link for GitHub -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>

  <!-- The engine is native to this package; Com.H.Data.Common supplies the parameterised
       database access (and, transitively, System.Text.Json on netstandard2.0). -->
  <ItemGroup>
    <PackageReference Include="Com.H.Data.Common" Version="[10.1.0.9, 11.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\128x128.jpg" Condition="Exists('..\128x128.jpg')">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include=".\nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
